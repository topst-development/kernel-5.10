	clk_hsio: gate_hsio {
		compatible = "telechips,clk-gate";
		#clock-cells = <1>;
		clocks = <&fbus_smu FBUS_HSIO>;
		clock-indices =
			<HSIOBUS_USB30>, <HSIOBUS_GMAC>,
			<HSIOBUS_USB20H>, <HSIOBUS_CIPHER>,
			<HSIOBUS_DWC_OTG>, <HSIOBUS_SECURE_WRAP>,
			<HSIOBUS_TRNG>;
		clock-output-names =
			"hsiobus_usb30", "hsiobus_gmac",
			"hsiobus_usb20h", "hsiobus_cipher",
			"hsiobus_dwc_otg", "hsiobus_secure_wrap",
			"hsiobus_trng";
		ccf-flags =
			<CLK_IGNORE_UNUSED>,    /* HSIOBUS_USB30 */
			<CLK_IGNORE_UNUSED>,    /* HSIOBUS_GMAC */
			<CLK_IGNORE_UNUSED>,    /* HSIOBUS_USB20H */
			<CLK_IGNORE_UNUSED>,    /* HSIOBUS_CIPHER */
			<CLK_IGNORE_UNUSED>,    /* HSIOBUS_DWC_OTG */
			<CLK_IGNORE_UNUSED>,    /* HSIOBUS_SECURE_WRAP */
			<CLK_IGNORE_UNUSED>;    /* HSIOBUS_TRNG */

		tc-flags =
			<(0)>,    /* HSIOBUS_USB30 */
			<(0)>,    /* HSIOBUS_GMAC */
			<(0)>,    /* HSIOBUS_USB20H */
			<(0)>,    /* HSIOBUS_CIPHER */
			<(0)>,    /* HSIOBUS_DWC_OTG */
			<(0)>,    /* HSIOBUS_SECURE_WRAP */
			<(0)>;    /* HSIOBUS_TRNG */
	};

	clk_ddi: gate_ddi {
		compatible = "telechips,clk-gate";
		#clock-cells = <1>;
		clocks = <&fbus_smu FBUS_DDI>;
		clock-indices =
			<DDIBUS_VIOC>, <DDIBUS_HDMI>, <DDIBUS_MIPI>,
			<DDIBUS_LVDS>;
		clock-output-names =
			"ddibus_vioc", "ddibus_hdmi", "ddibus_mipi",
			"ddibus_lvds";
		ccf-flags =
			<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>,	/* DDIBUS_VIOC */
			<CLK_IGNORE_UNUSED>,	/* DDIBUS_HDMI */
			<CLK_IGNORE_UNUSED>,	/* DDIBUS_MIPI */
			<CLK_IGNORE_UNUSED>;	/* DDIBUS_LVDS */

		tc-flags =
			<(0)>,	/* DDIBUS_VIOC */
			<(0)>,	/* DDIBUS_HDMI */
			<(0)>,	/* DDIBUS_MIPI */
			<(0)>;	/* DDIBUS_LVDS */
	};

	fbus_vpu: fbus_vpu {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m		OSC_XIN		VIDEO_CLKCTRL_SEL_XIN>,
			<&subsys_npll_3200	PLL_VIDEO_0	VIDEO_CLKCTRL_SEL_PLL0>,
			<&subsys_npll_3200	PLL_VIDEO_1	VIDEO_CLKCTRL_SEL_PLL1>,
			<&subsys_npll_3200	PLL_VIDEO_0	VIDEO_CLKCTRL_SEL_PLL0_DIV0>,
			<&subsys_npll_3200	PLL_VIDEO_0	VIDEO_CLKCTRL_SEL_PLL0_DIV1>,
			<&subsys_npll_3200	PLL_VIDEO_1	VIDEO_CLKCTRL_SEL_PLL1_DIV0>,
			<&subsys_npll_3200	PLL_VIDEO_1	VIDEO_CLKCTRL_SEL_PLL1_DIV1>;
		clock-indices =
			<FBUS_VBUS>, <FBUS_CODA>, <FBUS_CHEVCDEC>,
			<FBUS_BHEVCDEC>, <FBUS_CHEVCENC>, <FBUS_BHEVCENC>;
		clock-output-names =
			"fbus_vbus", "fbus_coda", "fbus_chevcdec",
			"fbus_bhevcdec", "fbus_chevcenc", "fbus_bhevcenc";
		ccf-flags =
			<(CLK_SET_RATE_GATE | CLK_IGNORE_UNUSED)>,    /* FBUS_VBUS */
			<(CLK_SET_RATE_GATE | CLK_IGNORE_UNUSED)>,    /* FBUS_CODA */
			<(CLK_SET_RATE_GATE | CLK_IGNORE_UNUSED)>,    /* FBUS_CHEVCDEC */
			<(CLK_SET_RATE_GATE | CLK_IGNORE_UNUSED)>,    /* FBUS_BHEVCDEC */
			<(CLK_SET_RATE_GATE | CLK_IGNORE_UNUSED)>,    /* FBUS_CHEVCENC */
			<(CLK_SET_RATE_GATE | CLK_IGNORE_UNUSED)>;    /* FBUS_BHEVCENC */

		tc-flags =
			<(0)>,    /* FBUS_VBUS */
			<(0)>,    /* FBUS_CODA */
			<(0)>,    /* FBUS_CHEVCDEC */
			<(0)>,    /* FBUS_BHEVCDEC */
			<(0)>,    /* FBUS_CHEVCENC */
			<(0)>;    /* FBUS_BHEVCENC */
	};

	clk_vpu: gate_vpu {
		compatible = "telechips,clk-gate";
		#clock-cells = <1>;
		clocks = <&fbus_vpu FBUS_VBUS>;
		clock-indices =
			<VIDEOBUS_JPEG>, <VIDEOBUS_CODA_BUS>,
			<VIDEOBUS_CODA_CORE>, <VIDEOBUS_HEVC_BUS>,
			<VIDEOBUS_HEVC_CORE>, <VIDEOBUS_HEVC_ENCODER>;
		clock-output-names =
			"videobus_jpeg", "videobus_coda_bus",
			"videobus_coda_core", "videobus_hevc_bus",
			"videobus_hevc_core", "videobus_hevc_encoder";
		ccf-flags =
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_JPEG */
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_CODA_BUS */
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_CODA_CORE */
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_HEVC_BUS */
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_HEVC_CORE */
			<CLK_IGNORE_UNUSED>;	/* VIDEOBUS_HEVC_ENCODER */
		tc-flags =
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_JPEG */
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_CODA_BUS */
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_CODA_CORE */
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_HEVC_BUS */
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_HEVC_CORE */
			<CLK_IGNORE_UNUSED>;	/* VIDEOBUS_HEVC_ENCODER */
	};
};
