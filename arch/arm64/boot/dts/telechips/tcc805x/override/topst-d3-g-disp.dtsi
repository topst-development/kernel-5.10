				#size-cells = <0>;
				reg = <0>;
			};
		};
	};

	/*----------------------------------------------------------------------
	 * Display Port
	 *----------------------------------------------------------------------
	 */
	dpv14_tx: dpv14_tx@12400000 {
		compatible = "telechips,dpv14-tx";
		reg = <0x0 0x12400000 0x0 0x100000>, <0x0 0x1B930000 0x0 0x78>,
		      <0x0 0x1B936000 0x0 0x258>;
		reg-names = "DDIBUS_BASE_ADD", "MICOM_SUB_SYSTEM_CONF",
			    "PMU_BASE_ADD";
		interrupts = <GIC_SPI 294 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "dp_hpd";
		clocks = <&clk_peri PERI_LCD0>, <&clk_peri PERI_LCD1>,
			 <&clk_peri PERI_LCD2>, <&clk_peri PERI_LCD3>;
		clock-names = "disp0-clk", "disp1-clk",
			      "disp2-clk", "disp3-clk";
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&dp_hpd_gpio>;
		pinctrl-1 = <&dp_hpd_gpio>;

		sink_vcp_id = <1 2 3 4>;

		/* default displayport configuration */
		dp-video-codes = <0 16 0 16 0 16 0 16>; /* video standard video codes */
		dp-phy-lane-swap = <1>;
		dp-max-lane = <4>;
		dp-max-rate = <3>;
		dp-spread-spectrum = <1>;

		status = "okay";

		hw-config {
			aux-hysteresis = <2>; /* hysteresis 0: 0mV, 1: 10mV, 2: 30mV, 3: 40mV */
			eq {
				status = "disabled";
				rbr {
					main = <0x08 0x0A 0x0C 0x10
						0x0C 0x0F 0x12 0xFF
						0x10 0x14 0xFF 0xFF
						0x18 0xFF 0xFF 0xFF>;
					post = <0x00 0x02 0x04 0x08
						0x00 0x03 0x06 0xFF
						0x00 0x04 0xFF 0xFF
						0x00 0xFF 0xFF 0xFF>;
				};
				hbr {
					main = <0x08 0x0A 0x0C 0x10
						0x0C 0x0F 0x12 0xFF
						0x10 0x14 0xFF 0xFF
						0x18 0xFF 0xFF 0xFF>;
					post = <0x00 0x02 0x04 0x08
						0x00 0x03 0x06 0xFF
						0x00 0x04 0xFF 0xFF
						0x00 0xFF 0xFF 0xFF>;
				};
				hbr2 {
					main = <0x08 0x0A 0x0C 0x10
						0x0C 0x0F 0x12 0xFF
						0x10 0x14 0xFF 0xFF
						0x18 0xFF 0xFF 0xFF>;
					post = <0x00 0x02 0x04 0x08
						0x00 0x03 0x06 0xFF
						0x00 0x04 0xFF 0xFF
						0x00 0xFF 0xFF 0xFF>;
				};
				hbr3 {
					main = <0x08 0x0A 0x0C 0x10
						0x0C 0x0F 0x12 0xFF
						0x10 0x14 0xFF 0xFF
						0x18 0xFF 0xFF 0xFF>;
					post = <0x00 0x02 0x04 0x08
						0x00 0x03 0x06 0xFF
						0x00 0x04 0xFF 0xFF
						0x00 0xFF 0xFF 0xFF>;
				};
			};
		};
	};
};

/*------------------------------------------------------------------------------
 * pinctrl
 *------------------------------------------------------------------------------
 */
&pinctrl {
	dp_hpd_gpio: dp_hpd_gpio {
		telechips,pins = "gpc-14";
		telechips,pin-function = <1>;
		telechips,input-enable;
		telechips,pull-down;
	};
};

/* end of file */

