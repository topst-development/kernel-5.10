&usb20drd_vbus {
	gpios = <&gpmd 14 0x0>;
};

&usb30drd_vbus {
	gpios = <&gpmd 16 0x0>;
};

&usb20host_vbus {
	gpios = <&gpmd 15 0x0>;
	status = "okay";
};

&usb20host_phy {
	status = "okay";
};

&usb20host_controller_usb20 {
	status = "okay";
};

&usb20host_controller_usb10 {
	status = "okay";
};
