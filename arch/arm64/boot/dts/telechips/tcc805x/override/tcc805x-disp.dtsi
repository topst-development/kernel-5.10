					reg = <0>;
					remote-endpoint = <&lvds0_in_vioc1>;
				};
				vioc1_output_lvds1: endpoint@0  {
					reg = <0>;
					remote-endpoint = <&lvds1_in_vioc1>;
				};
				vioc1_output_dp0: endpoint@0  {
					reg = <0>;
					remote-endpoint = <&dp0_in_vioc1>;
				};
				vioc1_output_dp1: endpoint@0  {
					reg = <0>;
					remote-endpoint = <&dp1_in_vioc1>;
				};
				vioc1_output_dp2: endpoint@0  {
					reg = <0>;
					remote-endpoint = <&dp2_in_vioc1>;
