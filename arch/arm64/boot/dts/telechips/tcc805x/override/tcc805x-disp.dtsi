		pinctrl-names = "default", "pwr_on_1", "pwr_on_2", "blk_on",
				"blk_off", "power_off";
		pinctrl-0 = <>;
		pinctrl-1 = <>;
		pinctrl-2 = <>;
		pinctrl-3 = <>;
		pinctrl-4 = <>;
		pinctrl-5 = <>;
		backlight = <>;
		display-timings {
			native-mode = <&timing_fb_lvds_auo>;
			timing_fb_lvds_auo: 1920x720p60 {
				clock-frequency = <108520000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <356>;
