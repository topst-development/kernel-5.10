	/*----------------------------------------------------------------------
	 * DRM VIOC (PLANE/CRTC)
	 *----------------------------------------------------------------------
	 */
	tccdrm_vioc0: tcc-drm-lcd {
		compatible = "telechips,drm-vioc-0";
		status = "disabled";
		display_device = <&vioc_disp VIOC_DISP0>;
		lcdc-mux-select = <3>;
		lcdc-mux-bypass = <1>; /* 1: Bypass, 0: Normal */
		wmixer = <&vioc_wmix VIOC_WMIX0>;
		rdma = <&vioc_rdma VIOC_RDMA00>;
		planes = "primary";
		clocks = <&clk_ddi DDIBUS_VIOC>, <&clk_peri PERI_LCD0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			vioc0_out: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;

				#if defined(CONFIG_EXAMPLES)
				vioc0_output_lvds0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&lvds0_in_vioc0>;
				};
				vioc0_output_lvds1: endpoint@0  {
					reg = <0>;
					remote-endpoint = <&lvds1_in_vioc0>;
				};
				vioc0_output_dp0: endpoint@0  {
					reg = <0>;
					remote-endpoint = <&dp0_in_vioc0>;
				};
				vioc0_output_dp1: endpoint@0  {
					reg = <0>;
					remote-endpoint = <&dp1_in_vioc0>;
				};
				vioc0_output_dp2: endpoint@0  {
					reg = <0>;
					remote-endpoint = <&dp2_in_vioc0>;
				};
				vioc0_output_dp3: endpoint@0  {
					reg = <0>;
					remote-endpoint = <&dp3_in_vioc0>;
				};
				vioc0_output_dummy0: endpoint@0  {
					reg = <0>;
					remote-endpoint = <&dummy0_in_vioc0>;
				};
				vioc0_output_dummy1: endpoint@0  {
					reg = <0>;
					remote-endpoint = <&dummy1_in_vioc0>;
				};
				vioc0_output_dummy2: endpoint@0  {
					reg = <0>;
					remote-endpoint = <&dummy2_in_vioc0>;
				};
				vioc0_output_dummy3: endpoint@0  {
					reg = <0>;
					remote-endpoint = <&dummy3_in_vioc0>;
				};
				#endif
			};
		};
	};

	tccdrm_vioc1: tcc-drm-ext {
		compatible = "telechips,drm-vioc-1";
		status = "disabled";
		display_device = <&vioc_disp VIOC_DISP1>;
		lcdc-mux-select = <0>;
		lcdc-mux-bypass = <0>; /* 1: Bypass, 0: Normal */
		wmixer = <&vioc_wmix VIOC_WMIX1>;
		rdma = <&vioc_rdma VIOC_RDMA04>;
		planes = "primary";
		clocks = <&clk_ddi DDIBUS_VIOC>, <&clk_peri PERI_LCD1>;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			vioc1_out: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;

				#if defined(CONFIG_EXAMPLES)
