	tcc_drm_dummy2: drm_dummy@2 {
		compatible = "telechips,drm-dummy-dev";
		status = "disabled";
		connector_type ="VIRTUAL"; // Incase of it is used as dummy display for Screen Share
		//connector_type ="LVDS";  // Incase of it is used as dummy display for DRM CRTC
		display-timings {
			#if (DRM_DUMMY2_PANEL_INDEX == LVDS_PANEL_AUO)
			native-mode = <&timing_dummy2_auo>;
			#else
			native-mode = <&timing_dummy2_boe>;
			#endif
			timing_dummy2_boe: 1920x720p60@0 {
				clock-frequency = <88200000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <30>;
				hback-porch = <30>;
				hsync-len = <4>;
				hsync-active = <0>;
				vback-porch = <9>;
				vfront-porch = <10>;
				vsync-len = <2>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
			timing_dummy2_auo: 1920x720p60@1 {
				clock-frequency = <88200000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <30>;
				hback-porch = <30>;
				hsync-len = <4>;
				hsync-active = <0>;
				vback-porch = <9>;
				vfront-porch = <10>;
				vsync-len = <2>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
		};
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			dummy2_in: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				#if defined(CONFIG_EXAMPLES)
				dummy2_in_vioc0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc0_output_dummy2>;
				};
				dummy2_in_vioc1: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc1_output_dummy2>;
				};
				dummy2_in_vioc2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc2_output_dummy2>;
				};
				dummy2_in_vioc3: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc3_output_dummy2>;
				};
				dummy2_in_screenshare: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&screenshare_out_dummy2>;
				};
				#endif
			};
			/*
			dummy2_out: port@1 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <1>;
				dummy2_out_panel0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&panel0_in_dummy2>;
				};
			};
			*/
		};
	};

