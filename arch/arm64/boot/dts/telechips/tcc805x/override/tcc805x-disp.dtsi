	tccdrm_screen_share: tcc-drm-screen-share {
		compatible = "telechips,tcc-drm-screen-share";
		status = "disabled";
		timer_device = <&vioc_timer>;
		display-timings {
			native-mode = <&timing_screen_share>;
			timing_screen_share: 1920x720p30 {
				clock-frequency = <44100000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <30>;
				hback-porch = <30>;
				hsync-len = <4>;
				hsync-active = <0>;
				vback-porch = <9>;
				vfront-porch = <10>;
				vsync-len = <2>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
		};
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			screen_share_display_out: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				#if defined(CONFIG_EXAMPLES)
				screenshare_out_dummy0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy0_in_screenshare>;
				};
				screenshare_out_dummy1: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy1_in_screenshare>;
				};
				screenshare_out_dummy2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy2_in_screenshare>;
				};
				screenshare_out_dummy3: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy3_in_screenshare>;
				};
				#endif
			};
		};
	};

	/* Encoders & Connectors ---------------------------------------------*/
	tccdrm_dp0: drm_dp@0 {
		compatible = "telechips,drm-dp";
		status = "disabled";
		display-timings {
			#if (DRM_DP0_PANEL_INDEX == LVDS_PANEL_AUO)
			native-mode = <&timing_drm_dp0_auo>;
			#else
			native-mode = <&timing_drm_dp0_boe>;
			#endif
			timing_drm_dp0_boe: 1920x720p60@0 {
				clock-frequency = <88200000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <30>;
				hback-porch = <30>;
				hsync-len = <4>;
				hsync-active = <0>;
				vback-porch = <9>;
				vfront-porch = <10>;
				vsync-len = <2>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
			timing_drm_dp0_auo: 1920x720p60@1 {
				clock-frequency = <108520000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <356>;
				hback-porch = <96>;
				hsync-len = <8>;
				hsync-active = <0>;
				vback-porch = <3>;
				vfront-porch = <36>;
				vsync-len = <1>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
		};
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			dp0_in: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				#if defined(CONFIG_EXAMPLES)
				dp0_in_vioc0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc0_output_dp0>;
				};
				dp0_in_vioc1: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc1_output_dp0>;
				};
				dp0_in_vioc2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc2_output_dp0>;
				};
				dp0_in_vioc3: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc3_output_dp0>;
				};
				#endif
			};
			dp0_out: port@1 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <1>;
				dp0_out_panel0: endpoint@0 {
					reg = <0>;
					//remote-endpoint = <&panel0_in_dp0>;
				};
			};
		};
	};

