	/*----------------------------------------------------------------------
	 * FB PANELs
	 *----------------------------------------------------------------------
	 */
	fb_tm123xdhp90: fb_tm123xdhp90 {
		compatible = "telechips,fb-lvds-tm123xdhp90";
		status = "disabled";
		lvds0 = <&lvds_phy>;
		mode = <LVDS_DUAL>;   /* 0: single 1: dual */
		phy-ports = <PHY_PORT_D0 PHY_PORT_D1>; /*port main, port sub*/
		data-mapping = "vesa-24";
		lane-main =
				<DATA3_LANE CLK_LANE DATA2_LANE DATA1_LANE DATA0_LANE>;
		lane-sub =
				<DATA0_LANE DATA1_LANE DATA2_LANE CLK_LANE DATA3_LANE>;
		vcm = <1200>;
		vsw = <500>;
		lcdc-mux-select = <2>;
		lcdc-mux-bypass = "true";
		pinctrl-names = "default", "pwr_on_1", "pwr_on_2", "blk_on",
				"blk_off", "power_off";
		pinctrl-0 = <>;
		pinctrl-1 = <>;
		pinctrl-2 = <>;
		pinctrl-3 = <>;
		pinctrl-4 = <>;
		pinctrl-5 = <>;
		backlight = <>;
		display-timings {
			native-mode = <&timing_fb_lvds_boe>;
			timing_fb_lvds_boe: 1920x720p60 {
				clock-frequency = <88200000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <28>;
				hback-porch = <28>;
				hsync-len = <8>;
				hsync-active = <0>;
				vback-porch = <10>;
				vfront-porch = <10>;
				vsync-len = <2>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
		};
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				panel_fb_boe_in: endpoint {
					//remote-endpoint = <&fb0_display_out>;
				};
			};
		};
	};

	fb_auoc123han06: fb_auoc123han06 {
		compatible = "telechips,fb-lvds-auoc123han06";
		status = "disabled";
		lvds0 = <&lvds_phy>;
		mode = <LVDS_DUAL>;   /* 0: single 1: dual */
