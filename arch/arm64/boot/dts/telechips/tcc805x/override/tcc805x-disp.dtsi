#include <dt-bindings/display/tcc805x-lvds.h>
#include <dt-bindings/display/display-defs.h>

/ {
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	/*----------------------------------------------------------------------
	 * aliases
	 *----------------------------------------------------------------------
	 */
	aliases: aliases {
		fb0 = &fb0;
	};
	/*----------------------------------------------------------------------
	 * pmap
	 *----------------------------------------------------------------------
	 */
	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;

		pmap_fb_video: fb_video {
			compatible = "telechips,pmap";
			telechips,pmap-name = "fb_video";
			//alloc-ranges = <0x0 RSVD_MEM_BASE_32 0x0 RSVD_MEM_SIZE_32>;
			//size = <0x0 PMAP_SIZE_FB_VIDEO>;
			//or
			//reg = <0x0 FB_VIDEO_BASE 0x0 PMAP_SIZE_FB_VIDEO>;
			//alignment = <0x1000>;
			status = "disabled";
		};

	};

	/*----------------------------------------------------------------------
	 * Backlight node
	 *----------------------------------------------------------------------
	 */
	lcd_port1_bl: lcd_port1_bl {
		status = "disabled";
		compatible = "gpio-backlight";
		#if defined(LCD_PORT1_BLK_GPIO) && defined(LCD_PORT1_BLK_NUM)
		gpios = <&LCD_PORT1_BLK_GPIO LCD_PORT1_BLK_NUM 0> ;
		#endif
	};

	lcd_port2_bl: lcd_port2_bl {
		status = "disabled";
		compatible = "gpio-backlight";
		#if defined(LCD_PORT2_BLK_GPIO) && defined(LCD_PORT2_BLK_NUM)
		gpios = <&LCD_PORT2_BLK_GPIO LCD_PORT2_BLK_NUM 0> ;
		#endif
	};

	lcd_port3_bl: lcd_port3_bl {
		status = "disabled";
		compatible = "gpio-backlight";
		#if defined(LCD_PORT3_BLK_GPIO) && defined(LCD_PORT3_BLK_NUM)
		gpios = <&LCD_PORT3_BLK_GPIO LCD_PORT3_BLK_NUM 0> ;
		#endif
	};

	lcd_port4_bl: lcd_port4_bl {
		status = "disabled";
		compatible = "gpio-backlight";
		#if defined(LCD_PORT4_BLK_GPIO) && defined(LCD_PORT4_BLK_NUM)
		gpios = <&LCD_PORT4_BLK_GPIO LCD_PORT4_BLK_NUM 0> ;
		#endif
	};

	/*----------------------------------------------------------------------
	 * DRM PANELs
	 *----------------------------------------------------------------------
	 */
	/*  P0> DP -----------------------------------------------------------*/
	panel_dp0: panel_dp@0 {
		compatible = "telechips,drm-lvds-dpv14-0";
		status = "disabled";
		pinctrl-names = "default", "sleep", "power_on", "reset_off",
				"blk_on", "blk_off", "power_off";
		pinctrl-0 = <>;
		pinctrl-1 = <>;
		pinctrl-2 = <>;
		pinctrl-3 = <>;
		pinctrl-4 = <>;
		pinctrl-5 = <>;
		pinctrl-6 = <>;
		backlight = <>;
		display-timings {
			#if (DRM_DP0_PANEL_INDEX == LVDS_PANEL_AUO)
			native-mode = <&timing_drm_dp0_panel_auo>;
			#else
			native-mode = <&timing_drm_dp0_panel_boe>;
			#endif
			timing_drm_dp0_panel_boe: 1920x720p60@0 {
				clock-frequency = <88200000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <30>;
				hback-porch = <30>;
				hsync-len = <4>;
				hsync-active = <0>;
				vback-porch = <9>;
				vfront-porch = <10>;
				vsync-len = <2>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
			timing_drm_dp0_panel_auo: 1920x720p60@1 {
				clock-frequency = <108520000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <356>;
				hback-porch = <96>;
				hsync-len = <8>;
				hsync-active = <0>;
				vback-porch = <3>;
				vfront-porch = <36>;
				vsync-len = <1>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
		};
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				panel0_in_dp0: endpoint@0 {
					reg = <0>;
					//remote-endpoint = <&dp0_out_panel0>;
				};
			};
		};
	};
	panel_dp1: panel_dp@1 {
		compatible = "telechips,drm-lvds-dpv14-1";
		status = "disabled";
		pinctrl-names = "default", "sleep", "power_on", "reset_off",
				"blk_on", "blk_off", "power_off";
		pinctrl-0 = <>;
		pinctrl-1 = <>;
		pinctrl-2 = <>;
		pinctrl-3 = <>;
		pinctrl-4 = <>;
		pinctrl-5 = <>;
		pinctrl-6 = <>;
		backlight = <>;
		display-timings {
			#if (DRM_DP1_PANEL_INDEX == LVDS_PANEL_AUO)
			native-mode = <&timing_drm_dp1_panel_auo>;
			#else
			native-mode = <&timing_drm_dp1_panel_boe>;
			#endif
			timing_drm_dp1_panel_boe: 1920x720p60@0 {
				clock-frequency = <88200000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <30>;
				hback-porch = <30>;
				hsync-len = <4>;
				hsync-active = <0>;
				vback-porch = <9>;
				vfront-porch = <10>;
				vsync-len = <2>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
			timing_drm_dp1_panel_auo: 1920x720p60@1 {
				clock-frequency = <108520000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <356>;
				hback-porch = <96>;
				hsync-len = <8>;
				hsync-active = <0>;
				vback-porch = <3>;
				vfront-porch = <36>;
				vsync-len = <1>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
		};
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				panel1_in_dp1: endpoint@0 {
					reg = <0>;
					//remote-endpoint = <&dp1_out_panel1>;
				};
			};
		};
	};

