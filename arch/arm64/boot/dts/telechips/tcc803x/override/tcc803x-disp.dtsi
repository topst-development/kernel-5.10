			dummy3_out: port@1 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <1>;
				dummy3_out_panel0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&panel0_in_dummy3>;
				};
			};
			*/
		};
	};

	tcc_drm_hdmi: tcc-drm-hdmi {
		compatible = "telechips,drm-hdmi";
		status = "disabled";
		/* +synopsys hdmi bridge+ */
		reg-io-width = <4>; // 32bit config
		ddi-config = <&ddi_config>;
		reg = <0x0 0x12400000 0x0 0x20000>,
			<0x0 0x12440000 0x0 0x1000>,
			<0x0 0x12480000 0x0 0x1000>,
			<0x0 0x163C0000 0x0 0x10>,
			<0x0 0x16051000 0x0 0x00000100>;
		reg-names = "hdmi_link", "hdcp_2.2", "hdmi_phy",
				"i2c_port_cfg", "hdmi_io_bus";

		clocks = <&clk_peri PERI_HDMI_CORE>,
				<&clk_peri PERI_HDMI_AUDIO>,
				<&clk_peri PERI_HDMI_PCLK>,
				<&clk_peri PERI_HDMI_HDCP14>,
				<&clk_peri PERI_HDMI_HDCP22>,
				<&clk_ddi DDIBUS_HDMI>;

		clock-names = "icore", 	/* phy clock */
				"iaudio",	/* spdif clock */
				"iahb",	/* apb clock 50Mhz */
				"isfr",	/* hdcp 1.4 clock */
				"hdmi_hdcp22",
				"hdmi_ddibus";

		interrupts = <GIC_SPI 123 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "hdmi_link";

		pinctrl-names = "default", "unwedge";
		pinctrl-0 = <&hdmi_hpd &hdmi_i2c>;
		pinctrl-1 = <&hdmi_i2c_unwedge>;

		audio_if_i2s_mux = <1>; /* 0: CH0, 1: CH1, 2: CH2 */
		audio_if_selection_offset = <0x58>;
		audio_rx_tx_chmux = <0x98>;

		/* -synopsys hdmi bridge- */

		display-timings {
			native-mode = <&timing_hdmi>;
			timing_hdmi: 1920x720p60 {
				clock-frequency = <88200000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <30>;
				hback-porch = <30>;
				hsync-len = <4>;
				hsync-active = <0>;
				vback-porch = <9>;
				vfront-porch = <10>;
				vsync-len = <2>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			hdmi_in: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;

				#if defined(CONFIG_EXAMPLES)
				hdmi_in_vioc0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc0_output_hdmi>;
				};
				hdmi_in_vioc1: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc1_output_hdmi>;
				};
				hdmi_in_vioc2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc2_output_hdmi>;
				};
				#endif
				/*
				hdmi_out: port@1 {
					#address-cells = <1>;
					#size-cells = <0>;
					reg = <1>;
					hdmi_in_out_panel0: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&panel0_in_hdmi_in>;
					};
				};
				*/
			};
		};
	};
	/* DRM ROOT NODES-- */

	/*----------------------------------------------------------------------
	 * FB VIOCS
	 *----------------------------------------------------------------------
	 */
	fb0: fb@0 {
		compatible = "telechips,fb";
		status = "disabled";
		clocks = <&clk_ddi DDIBUS_VIOC>;
		memory-region = <>;
		xres = <1920>;
		yres = <720>;
		bpp = <32>;
		chroma-key = <0x0 0x0 0x0>;
		chroma-mkey = <0xF8 0xFC 0xF8>;
		mode = <FBX_TRIPLE>;
		update-type = <FBX_RDMA_UPDATE>;
		device-priority = <FBX_DEVICE_LVDS>;
		telechips,disp = <&vioc_disp VIOC_DISP0>;
		telechips,wmixer = <&vioc_wmix VIOC_WMIX0>;
		telechips,rdma = <&vioc_rdma VIOC_RDMA00>;
	};

	fb1: fb@1 {
		compatible = "telechips,fb";
		status = "disabled";
		clocks = <&clk_ddi DDIBUS_VIOC>;
		memory-region = <>;
		xres = <1920>;
		yres = <720>;
		bpp = <32>;
		chroma-key = <0x0 0x0 0x0>;
		chroma-mkey = <0xF8 0xFC 0xF8>;
		mode = <FBX_TRIPLE>;
		update-type = <FBX_OVERLAY_UPDATE>;
		device-priority = <FBX_DEVICE_LVDS>;
		telechips,disp = <&vioc_disp VIOC_DISP0>;
		telechips,wmixer = <&vioc_wmix VIOC_WMIX0>;
		telechips,rdma = <&vioc_rdma VIOC_RDMA01>;
	};

	fb2: fb@2 {
		compatible = "telechips,fb";
		status = "disabled";
		clocks = <&clk_ddi DDIBUS_VIOC>;
		memory-region = <>;
		xres = <1920>;
		yres = <720>;
		bpp = <32>;
		chroma-key = <0x0 0x0 0x0>;
		chroma-mkey = <0xF8 0xFC 0xF8>;
		mode = <FBX_TRIPLE>;
		update-type = <FBX_RDMA_UPDATE>;
		device-priority = <FBX_DEVICE_HDMI>;
		telechips,disp = <&vioc_disp VIOC_DISP1>;
		telechips,wmixer = <&vioc_wmix VIOC_WMIX1>;
		telechips,rdma = <&vioc_rdma VIOC_RDMA04>;
	};

	fb3: fb@3 {
		compatible = "telechips,fb";
		status = "disabled";
		clocks = <&clk_ddi DDIBUS_VIOC>;
		memory-region = <>;
		xres = <1920>;
		yres = <720>;
		bpp = <32>;
		chroma-key = <0x0 0x0 0x0>;
		chroma-mkey = <0xF8 0xFC 0xF8>;
		mode = <FBX_TRIPLE>;
		update-type = <FBX_OVERLAY_UPDATE>;
		device-priority = <FBX_DEVICE_LVDS>;
		telechips,disp = <&vioc_disp VIOC_DISP1>;
		telechips,wmixer = <&vioc_wmix VIOC_WMIX1>;
		telechips,rdma = <&vioc_rdma VIOC_RDMA06>;
	};

	/*----------------------------------------------------------------------
	 * HDMI Driver (Legacy)
	 *----------------------------------------------------------------------
	 */
	hdmi_tx_20: hdmi_tx_20@12400000 {
		compatible = "telechips,dw-hdmi-tx";
		status = "disabled";

		/* Register */
		reg = <0x0 0x12400000 0x0 0x20000>,
				<0x0 0x12440000 0x0 0x1000>,
				<0x0 0x12480000 0x0 0x1000>,
				<0x0 0x163C0000 0x0 0x10>,
				<0x0 0x16051000 0x0 0x100>;
		reg-names = "hdmi_link", "hdcp_2.2", "hdmi_phy", "i2c_port_cfg", "iobus_configure";
		/* Interrupt */
		interrupts = <GIC_SPI 123 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 126 IRQ_TYPE_LEVEL_HIGH>,
				<GIC_SPI 127 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "hdmi_link", "hdcp_2.2", "hdmi_cec";
		/* Clocks */
		clocks = <&clk_peri PERI_HDMI_CORE>,
				<&clk_peri PERI_HDMI_AUDIO>,
				<&clk_peri PERI_HDMI_PCLK>,
				<&clk_peri PERI_HDMI_CEC>,
				<&clk_peri PERI_HDMI_HDCP14>,
				<&clk_peri PERI_HDMI_HDCP22>,
				<&clk_ddi DDIBUS_HDMI>,
				<&clk_ddi DDIBUS_VIOC>;
		clock-names = "hdmi_ref_clk",
				"hdmi_spdif_clk",
				"hdmi_apb_clk",
				"hdmi_cec",
				"hdmi_hdcp14",
				"hdmi_hdcp22",
				"hdmi_ddibus",
				"ddi_bus";
		clock-frequency = <50000000>;
		/* Pinctrl and gpio */
		pinctrl-names = "default";
		pinctrl-0 = <&hdmi_hpd>;
		gpios = <&gpc 14 0>;

		/* DDC */
		hdmi_i2c_port_disable = <1>;
		hdmi_i2c_port_mapping = <0xc 0xff 0x1d>;	/* offset mask value */

		/* Source Product Description */
		vendor_name = "TCC";
		product_description = "TCC8031";
		source_information = <1>;	/* Digital STB */

		audio_if_i2s_mux = <1>;	/* 0: CH0, 1: CH1, 2: CH2 */
		audio_if_selection_ofst = <0x58>;
		audio_rx_tx_chmux = <0x98>;

		/* fixed video identification code 4: 1280x720p 60Hz */
		fixd_video_id_code = <4>;

		verbose = <0>;	// 0 disable, 1 basic, 2 io
	};
};

/*--------------------------------------------------------------------------
 * pinctrl
 *--------------------------------------------------------------------------
 */
&pinctrl {
	/*
	 * HDMI PINCTRL
	 */
	hdmi_hpd: hdmi_hpd {
		telechips,pins = "gpc-14";
		telechips,pin-function = <1>;
		telechips,pull-down;
	};

	hdmi_i2c: hdmi_i2c {
		telechips,pins = "gpc-8", "gpc-9";
		telechips,pin-function = <1>;
		telechips,pull-up;
	};

	hdmi_i2c_unwedge: hdmi_i2c_unwedge {
		telechips,pins = "gpc-9";
		telechips,pin-function = <0>;
		telechips,output-low;
	};

	/*
	 * RGB Interface pinctrl
	 */
	lcd_lpxclk: lcd_lpxclk {
		telechips,pins = "gpb-0";
		telechips,pin-function = <1>;
	};

	lcd_lpxclk_idle: lcd_lpxclk_idle {
		telechips,pins = "gpb-0";
		telechips,pin-function = <0>;
		telechips,output-low = <0>;
	};

	lcd_lhsync: lcd_lhsync {
		telechips,pins = "gpb-1";
		telechips,pin-function = <1>;
	};

	lcd_lhsync_idle: lcd_lhsync_idle {
		telechips,pins = "gpb-1";
		telechips,pin-function = <0>;
		telechips,output-low = <0>;
	};

	lcd_lvsync: lcd_lvsync {
		telechips,pins = "gpb-2";
		telechips,pin-function = <1>;
	};

	lcd_lvsync_idle: lcd_lvsync_idle {
		telechips,pins = "gpb-2";
		telechips,pin-function = <0>;
		telechips,output-low = <0>;
	};

	lcd_lacbias: lcd_lacbias {
		telechips,pins = "gpb-19";
		telechips,pin-function = <1>;
	};

	lcd_lacbias_idle: lcd_lacbias_idle {
		telechips,pins = "gpb-19";
		telechips,pin-function = <0>;
		telechips,output-low = <0>;
	};

	lcd_lpd: lcd_lpd {
		telechips,pins ="gpb-3", "gpb-4", "gpb-5", "gpb-6",
				"gpb-7", "gpb-8", "gpb-9", "gpb-10",
				"gpb-11", "gpb-12", "gpb-13", "gpb-14",
				"gpb-15", "gpb-16", "gpb-17", "gpb-18",
				"gpb-20", "gpb-21", "gpb-22", "gpb-23",
				"gpb-24", "gpb-25", "gpb-26", "gpb-27";
		telechips,pin-function = <1>;
	};

	lcd_lpd_idle: lcd_lpd_idle {
		telechips,pins ="gpb-3", "gpb-4", "gpb-5", "gpb-6",
				"gpb-7", "gpb-8", "gpb-9", "gpb-10",
				"gpb-11", "gpb-12", "gpb-13", "gpb-14",
				"gpb-15", "gpb-16", "gpb-17", "gpb-18",
				"gpb-20", "gpb-21", "gpb-22", "gpb-23",
				"gpb-24", "gpb-25", "gpb-26", "gpb-27";
		telechips,pin-function = <0>;
		telechips,output-low = <0>;
	};
};


/* end of file */
