				reg = <0>;

				#if defined(CONFIG_EXAMPLES)
				dummy2_in_vioc0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc0_output_dummy2>;
				};
				dummy2_in_vioc1: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc1_output_dummy2>;
				};
				dummy2_in_vioc2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc2_output_dummy2>;
				};
				dummy2_in_screenshare: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&screen_share_display_out>;
				};
				#endif
			};
			/*
			dummy2_out: port@1 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <1>;
				dummy2_out_panel0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&panel0_in_dummy2>;
				};
			};
			*/
		};
	};

	tcc_drm_dummy3: drm_dummy@3 {
		compatible = "telechips,drm-dummy-dev";
		status = "disabled";
		#if (DT_DISPDEV_FOR_SCREENSHARE == DT_DISPDEV_DUMMY3)
