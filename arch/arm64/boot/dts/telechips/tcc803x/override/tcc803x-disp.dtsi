#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/telechips,tcc803x-clks.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/soc/tcc803x,membase.h>
#include <dt-bindings/display/tcc803x-vioc.h>

/ {
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	/*----------------------------------------------------------------------
	 * aliases
	 *----------------------------------------------------------------------
	 */
	aliases: aliases {
		fb0 = &fb0;
		fb1 = &fb1;
		fb2 = &fb2;
		fb3 = &fb3;
	};

	/*--------------------------------------------------------------------------
	 * pmap
	 *--------------------------------------------------------------------------
	 */
	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;

		pmap_fb_video: fb_video {
			compatible = "telechips,pmap";
			telechips,pmap-name = "fb_video";
			//alloc-ranges = <0x0 RSVD_MEM_BASE_32 0x0 RSVD_MEM_SIZE_32>;
			//size = <0x0 PMAP_SIZE_FB_VIDEO>;
			//or
			//reg = <0x0 FB_VIDEO_BASE 0x0 PMAP_SIZE_FB_VIDEO>;
			//alignment = <0x1000>;
			status = "disabled";
		};

		pmap_fb1_video: fb1_video {
			compatible = "telechips,pmap";
			telechips,pmap-name = "fb1_video";
			//alloc-ranges = <0x0 RSVD_MEM_BASE_32 0x0 RSVD_MEM_SIZE_32>;
			//size = <0x0 PMAP_SIZE_FB1_VIDEO>;
			//or
			//reg = <0x0 FB1_VIDEO_BASE 0x0 PMAP_SIZE_FB1_VIDEO>;
			//alignment = <0x1000>;
			status = "disabled";
		};

		pmap_fb2_video: fb2_video {
			compatible = "telechips,pmap";
			telechips,pmap-name = "fb2_video";
			//alloc-ranges = <0x0 RSVD_MEM_BASE_32 0x0 RSVD_MEM_SIZE_32>;
			//size = <0x0 PMAP_SIZE_FB2_VIDEO>;
			//or
			//reg = <0x0 FB2_VIDEO_BASE 0x0 PMAP_SIZE_FB2_VIDEO>;
			//alignment = <0x1000>
			status = "disabled";
		};

		pmap_fb3_video: fb3_video {
			compatible = "telechips,pmap";
			telechips,pmap-name = "fb3_video";
			//alloc-ranges = <0x0 RSVD_MEM_BASE_32 0x0 RSVD_MEM_SIZE_32>;
			//size = <0x0 PMAP_SIZE_FB3_VIDEO>;
			//or
			//reg = <0x0 FB3_VIDEO_BASE 0x0 PMAP_SIZE_FB3_VIDEO>;
			//alignment = <0x1000>

			status = "disabled";
		};
	};

	/*----------------------------------------------------------------------
	 * DRM VIOC (PLANE/CRTC)
	 *----------------------------------------------------------------------
	 */
	tccdrm_vioc0: tcc-drm-lcd {
		compatible = "telechips,drm-vioc-0";
		status = "disabled";
		display_device = <&vioc_disp VIOC_DISP0>;
		wmixer = <&vioc_wmix VIOC_WMIX0>;
		rdma = <&vioc_rdma VIOC_RDMA00>;
		planes = "primary";
		clocks = <&clk_ddi DDIBUS_VIOC>, <&clk_peri PERI_LCD0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			vioc0_out: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;

				#if defined(CONFIG_EXAMPLES)
				vioc0_output_dummy0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy0_in_vioc0>;
				};
				vioc0_output_dummy1: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy1_in_vioc0>;
				};
				vioc0_output_dummy2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy2_in_vioc0>;
				};
				vioc0_output_dummy3: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy3_in_vioc0>;
				};
				vioc0_output_hdmi: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&hdmi_in_vioc0>;
				};
				#endif
			};
		};
	};

	tccdrm_vioc1: tcc-drm-ext {
		compatible = "telechips,drm-vioc-1";
		display_device = <&vioc_disp VIOC_DISP1>;
		wmixer = <&vioc_wmix VIOC_WMIX1>;
		rdma = <&vioc_rdma VIOC_RDMA04>;
		planes = "primary";
		clocks = <&clk_ddi DDIBUS_VIOC>, <&clk_peri PERI_LCD1>;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			vioc1_out: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;

				#if defined(CONFIG_EXAMPLES)
				vioc1_output_dummy0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy0_in_vioc1>;
				};
				vioc1_output_dummy1: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy1_in_vioc1>;
				};
				vioc1_output_dummy2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy2_in_vioc1>;
				};
				vioc1_output_dummy3: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy3_in_vioc1>;
				};
				vioc1_output_hdmi: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&hdmi_in_vioc1>;
				};
				#endif
			};
		};
	};

	tccdrm_vioc2: tcc-drm-third {
		compatible = "telechips,drm-vioc-2";
		status = "disabled";
		display_device = <&vioc_disp VIOC_DISP2>;
		wmixer = <&vioc_wmix VIOC_WMIX2>;
		rdma = <&vioc_rdma VIOC_RDMA08>;
		planes = "primary";
		clocks = <&clk_ddi DDIBUS_VIOC>, <&clk_peri PERI_LCD2>;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			vioc2_out: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;

				#if defined(CONFIG_EXAMPLES)
				vioc2_output_dummy0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy0_in_vioc2>;
				};
				vioc2_output_dummy1: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy1_in_vioc2>;
				};
				vioc2_output_dummy2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy2_in_vioc2>;
				};
				vioc2_output_dummy3: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy3_in_vioc2>;
				};
				vioc2_output_hdmi: endpoint@1 {
					reg = <0>;
					remote-endpoint = <&hdmi_in_vioc2>;
				};
				#endif
			};
		};
	};

	tccdrm_screen_share: tcc-drm-screen-share {
		compatible = "telechips,tcc-drm-screen-share";
		status = "disabled";
		timer_device = <&vioc_timer>;
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			screen_share_display_in: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;

				reg = <0>;
				#if defined(CONFIG_EXAMPLES)
				screen_share_display_out: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy0_in_screenshare>;
				};
				screen_share_display_out: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy1_in_screenshare>;
				};
				screen_share_display_out: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy2_in_screenshare>;
				};
				screen_share_display_out: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&dummy3_in_screenshare>;
				};
				#endif
			};
		};
	};

	tcc_drm_dummy0: drm_dummy@0 {
		compatible = "telechips,drm-dummy-dev";
		status = "disabled";
		#if (DT_DISPDEV_FOR_SCREENSHARE == DT_DISPDEV_DUMMY0)
		connector_type ="VIRTUAL";
		#else
		connector_type ="LVDS";
		#endif
		display-timings {
			#if (DRM_DUMMY0_PANEL_INDEX == LVDS_PANEL_AUO)
			native-mode = <&timing_dummy0_auo>;
			#else
			native-mode = <&timing_dummy0_boe>;
			#endif
			timing_dummy0_boe: 1920x720p60@0 {
				clock-frequency = <88200000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <30>;
				hback-porch = <30>;
				hsync-len = <4>;
				hsync-active = <0>;
				vback-porch = <9>;
				vfront-porch = <10>;
				vsync-len = <2>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
			timing_dummy0_auo: 1920x720p60@1 {
				clock-frequency = <108520000>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <356>;
				hback-porch = <96>;
				hsync-len = <8>;
				hsync-active = <0>;
				vback-porch = <3>;
				vfront-porch = <36>;
				vsync-len = <1>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
		};
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			dummy0_in: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;

				#if defined(CONFIG_EXAMPLES)
				dummy0_in_vioc0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc0_output_dummy0>;
				};
				dummy0_in_vioc1: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc1_output_dummy0>;
				};
				dummy0_in_vioc2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc2_output_dummy0>;
				};
				dummy0_in_screenshare: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&screen_share_display_out>;
				};
				#endif
			};
			/*
			dummy0_out: port@1 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <1>;
				dummy0_out_panel0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&panel0_in_dummy0>;
				};
			};
			*/
		};
	};

	tcc_drm_dummy1: drm_dummy@1 {
		compatible = "telechips,drm-dummy-dev";
		status = "disabled";
		#if (DT_DISPDEV_FOR_SCREENSHARE == DT_DISPDEV_DUMMY1)
		connector_type ="VIRTUAL";
		#else
		connector_type ="LVDS";
		#endif
		display-timings {
			native-mode = <&timing_dummy1>;
			timing_dummy1: 1024x600p60 {
				clock-frequency = <51200000>;
				hactive = <1024>;
				vactive = <600>;
				hfront-porch = <147>;
				hback-porch = <147>;
				hsync-len = <19>;
				hsync-active = <0>;
				vback-porch = <10>;
				vfront-porch = <25>;
				vsync-len = <2>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
		};
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			dummy1_in: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;

				#if defined(CONFIG_EXAMPLES)
				dummy1_in_vioc0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc0_output_dummy1>;
				};
				dummy1_in_vioc1: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc1_output_dummy1>;
				};
				dummy1_in_vioc2: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&vioc2_output_dummy1>;
				};
				dummy1_in_screenshare: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&screen_share_display_out>;
				};
				#endif
			};
			/*
			dummy1_out: port@1 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <1>;
				dummy1_out_panel0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&panel0_in_dummy1>;
				};
			};
			*/
		};
	};

	tcc_drm_dummy2: drm_dummy@2 {
		compatible = "telechips,drm-dummy-dev";
		status = "disabled";
		#if (DT_DISPDEV_FOR_SCREENSHARE == DT_DISPDEV_DUMMY2)
