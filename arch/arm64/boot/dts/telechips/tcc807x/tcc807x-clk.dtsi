		clock-output-names = "fbus_npu";
		ccf-flags = <(CLK_IGNORE_UNUSED)>;
		tc-flags =  <(0)>;
	};

	clk_io: gate_io {
		compatible = "telechips,clk-gate";
		#clock-cells = <1>;
		clocks = <&fbus_smu FBUS_IO>;
