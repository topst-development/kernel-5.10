	clk_hsio: gate_hsio {
		compatible = "telechips,clk-gate";
		#clock-cells = <1>;
		clocks = <&fbus_smu FBUS_HSIO>;
		clock-indices =
			<HSIOBUS_USB30>, <HSIOBUS_GMAC>,
			<HSIOBUS_USB20H>, <HSIOBUS_CIPHER>,
			<HSIOBUS_DWC_OTG>, <HSIOBUS_SECURE_WRAP>,
			<HSIOBUS_TRNG>;
		clock-output-names =
			"hsiobus_usb30", "hsiobus_gmac",
			"hsiobus_usb20h", "hsiobus_cipher",
			"hsiobus_dwc_otg", "hsiobus_secure_wrap",
			"hsiobus_trng";
		ccf-flags =
			<CLK_IGNORE_UNUSED>,    /* HSIOBUS_USB30 */
			<CLK_IGNORE_UNUSED>,    /* HSIOBUS_GMAC */
			<CLK_IGNORE_UNUSED>,    /* HSIOBUS_USB20H */
			<CLK_IGNORE_UNUSED>,    /* HSIOBUS_CIPHER */
			<CLK_IGNORE_UNUSED>,    /* HSIOBUS_DWC_OTG */
			<CLK_IGNORE_UNUSED>,    /* HSIOBUS_SECURE_WRAP */
			<CLK_IGNORE_UNUSED>;    /* HSIOBUS_TRNG */
		tc-flags =
			<(0)>,    /* HSIOBUS_USB30 */
			<(0)>,    /* HSIOBUS_GMAC */
			<(0)>,    /* HSIOBUS_USB20H */
			<(0)>,    /* HSIOBUS_CIPHER */
			<(0)>,    /* HSIOBUS_DWC_OTG */
			<(0)>,    /* HSIOBUS_SECURE_WRAP */
			<(0)>;    /* HSIOBUS_TRNG */
	};

	clk_ddi: gate_ddi {
		compatible = "telechips,clk-gate";
		#clock-cells = <1>;
		clocks = <&fbus_smu FBUS_DDI>;
		clock-indices = <DDIBUS_VIOC>;
		clock-output-names = "ddibus_vioc";
		ccf-flags = <(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>;
		tc-flags =  <(0)>;
	};

	fbus_vpu: fbus_vpu {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m		OSC_XIN		VIDEO_CLKCTRL_SEL_XIN>,
			<&subsys_dpll_3200	PLL_VIDEO_0	VIDEO_CLKCTRL_SEL_PLL0>,
			<&subsys_dpll_3200	PLL_VIDEO_1	VIDEO_CLKCTRL_SEL_PLL1>,
			<&subsys_dpll_3200	PLL_VIDEO_0	VIDEO_CLKCTRL_SEL_PLL0_DIV0>,
			<&subsys_dpll_3200	PLL_VIDEO_0	VIDEO_CLKCTRL_SEL_PLL0_DIV1>,
			<&subsys_dpll_3200	PLL_VIDEO_1	VIDEO_CLKCTRL_SEL_PLL1_DIV0>,
			<&subsys_dpll_3200	PLL_VIDEO_1	VIDEO_CLKCTRL_SEL_PLL1_DIV1>;
		clock-indices =
			<FBUS_VBUS>, <FBUS_CODA>, <FBUS_CHEVCDEC>,
			<FBUS_BHEVCDEC>, <FBUS_CHEVCENC>, <FBUS_BHEVCENC>;
		clock-output-names =
			"fbus_vbus", "fbus_coda", "fbus_chevcdec",
			"fbus_bhevcdec", "fbus_chevcenc", "fbus_bhevcenc";
		ccf-flags =
				<(CLK_IGNORE_UNUSED)>,
				<(CLK_IGNORE_UNUSED)>,
				<(CLK_IGNORE_UNUSED)>,
				<(CLK_IGNORE_UNUSED)>,
				<(CLK_IGNORE_UNUSED)>,
				<(CLK_IGNORE_UNUSED)>;
		tc-flags =
				<(0)>,
				<(0)>,
				<(0)>,
				<(0)>,
				<(0)>,
				<(0)>;
	};

	clk_vpu: gate_vpu {
		compatible = "telechips,clk-gate";
		#clock-cells = <1>;
		clocks = <&fbus_vpu FBUS_VBUS>;
		clock-indices =
			<VIDEOBUS_JPEG>, <VIDEOBUS_CODA_BUS>,
			<VIDEOBUS_CODA_CORE>, <VIDEOBUS_HEVC_BUS>,
			<VIDEOBUS_HEVC_CORE>, <VIDEOBUS_HEVC_ENCODER0>,
			<VIDEOBUS_HEVC_ENCODER1>;
		clock-output-names =
			"videobus_jpeg", "videobus_coda_bus",
			"videobus_coda_core", "videobus_hevc_bus",
			"videobus_hevc_core", "videobus_hevc_encoder0",
			"videobus_hevc_encoder1";
		ccf-flags =
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_JPEG */
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_CODA_BUS */
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_CODA_CORE */
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_HEVC_BUS */
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_HEVC_CORE */
			<CLK_IGNORE_UNUSED>,	/* VIDEOBUS_HEVC_ENCODER0 */
			<CLK_IGNORE_UNUSED>;	/* VIDEOBUS_HEVC_ENCODER1 */
		tc-flags =
			<(0)>,	/* VIDEOBUS_JPEG */
			<(0)>,	/* VIDEOBUS_CODA_BUS */
			<(0)>,	/* VIDEOBUS_CODA_CORE */
			<(0)>,	/* VIDEOBUS_HEVC_BUS */
			<(0)>,	/* VIDEOBUS_HEVC_CORE */
			<(0)>,	/* VIDEOBUS_HEVC_ENCODER0 */
			<(0)>;	/* VIDEOBUS_HEVC_ENCODER1 */
	};

	fbus_audio: fbus_audio {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m		OSC_XIN		AUDIO_CLKCTRL_SEL_XIN>,
			<&subsys_dpll_3200	PLL_AUDIO_0	AUDIO_CLKCTRL_SEL_PLL0>,
			<&subsys_dpll_3200	PLL_AUDIO_1	AUDIO_CLKCTRL_SEL_PLL1>,
			<&subsys_dpll_3200	PLL_AUDIO_0	AUDIO_CLKCTRL_SEL_PLL0_DIV>,
			<&subsys_dpll_3200	PLL_AUDIO_1	AUDIO_CLKCTRL_SEL_PLL1_DIV>;
		clock-indices = <FBUS_AUDIO>;
		clock-output-names = "fbus_audio";
		ccf-flags = <(CLK_IGNORE_UNUSED)>;
		tc-flags = <(0)>;
	};

	peri_audio: clk@19600000 {
		compatible = "telechips,clk-peri";
		#clock-cells = <1>;
		clocks =
			<&subsys_dpll_3200 PLL_AUDIO_0 AUDIO_PCLKCTRL_SEL_PLL0>,
