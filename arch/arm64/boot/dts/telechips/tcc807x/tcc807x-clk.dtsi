#include <dt-bindings/clock/telechips,tcc807x-clks.h>

/ {
	osc24m: osc24m {
		compatible = "fixed-clock";
		#clock-cells = <2>;
		clock-frequency = <24000000>;
		clock-output-names = "osc24m";
	};

	osc32k: osc32k {
		compatible = "fixed-clock";
		#clock-cells = <2>;
		clock-frequency = <32768>;
		clock-output-names = "osc32k";
	};

	extclk0: extclk0 {
		compatible = "fixed-clock";
		#clock-cells = <2>;
		clock-frequency = <0>;
		clock-output-names = "extclk0";
	};

	extclk1: extclk1 {
		compatible = "fixed-clock";
		#clock-cells = <2>;
		clock-frequency = <0>;
		clock-output-names = "extclk1";
	};

	smu_dpll_3200: smu_dpll_3200 {
		compatible = "telechips,clk-pll";
		type-fixed;
		#clock-cells = <2>;
		clocks = <&osc24m 0 0>;
		clock-indices = <PLL_4>, <PLL_3>, <PLL_2>;
		clock-output-names = "pll4", "pll3", "pll2";

		ccf-flags =	<(CLK_IGNORE_UNUSED)>,	/*PLL_4*/
				<(CLK_IGNORE_UNUSED)>,	/*PLL_3*/
				<(CLK_IGNORE_UNUSED)>;	/*PLL_2*/

		tc-flags =	<(0)>,	/*PLL_4*/
				<(0)>,	/*PLL_3*/
				<(0)>;	/*PLL_2*/
	};

	smu_npll_3200: smu_npll_3200 {
		compatible = "telechips,clk-pll";
		type-fixed;
		#clock-cells = <2>;
		clocks = <&osc24m 0 0>;
		clock-indices = <PLL_1>, <PLL_0>;
		clock-output-names = "pll1", "pll0";

		ccf-flags =	<(CLK_IGNORE_UNUSED)>,	/*PLL_1*/
				<(CLK_IGNORE_UNUSED)>;	/*PLL_0*/

		tc-flags =	<(0)>,	/*PLL_1*/
				<(0)>;	/*PLL_0*/
	};

	mem_phy_pll_6600: mem_phy_pll_6600 {
		compatible = "telechips,clk-pll";
		#clock-cells = <2>;
		clocks = <&osc24m 0 0>;
		clock-indices =
			<PLL_MEMPHY_3>, <PLL_MEMPHY_2>,
			<PLL_MEMPHY_1>, <PLL_MEMPHY_0>;
		clock-output-names =
			"pll_memphy3", "pll_memphy2",
			"pll_memphy1", "pll_memphy0";
		ccf-flags =	<(CLK_IGNORE_UNUSED)>,	/*PLL_MEM_PHY_3*/
				<(CLK_IGNORE_UNUSED)>,	/*PLL_MEM_PHY_2*/
				<(CLK_IGNORE_UNUSED)>,	/*PLL_MEM_PHY_1*/
				<(CLK_IGNORE_UNUSED)>;	/*PLL_MEM_PHY_0*/
		tc-flags =	<(0)>,	/*PLL_MEM_PHY_3*/
				<(0)>,	/*PLL_MEM_PHY_2*/
				<(0)>,	/*PLL_MEM_PHY_1*/
				<(0)>;	/*PLL_MEM_PHY_0*/
	};

	subsys_npll_3200: subsys_npll_3200 {
		compatible = "telechips,clk-pll";
		#clock-cells = <2>;
		clocks = <&osc24m 0 0>;
		clock-indices = <PLL_G2D>, <PLL_CAM>, <PLL_DP>;
		clock-output-names = "pll_g2d", "pll_cam", "pll_dp";
		ccf-flags =	<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>,
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>,
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>;
		tc-flags =	<(0)>,
				<(0)>,
				<(0)>;
	};

	subsys_dpll_3200: subsys_dpll_3200 {
		compatible = "telechips,clk-pll";
		#clock-cells = <2>;
		clocks = <&osc24m 0 0>;
		clock-indices =
			<PLL_NPU>,
			<PLL_AUDIO_1>, <PLL_AUDIO_0>,
			<PLL_VIDEO_1>, <PLL_VIDEO_0>,
			<PLL_GPU>,
			<PLL_MEM_1>, <PLL_MEM_0>;
		clock-output-names =
			"pll_npu",
			"pll_audio1", "pll_audio0",
			"pll_video1", "pll_video0",
			"pll_gpu",
			"pll_mem1", "pll_mem0";
		ccf-flags =
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>,
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>,
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>,
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>,
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>,
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>,
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>,
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>;
		tc-flags =
				<(0)>,
				<(0)>,
				<(0)>,
				<(0)>,
				<(0)>,
				<(0)>,
				<(0)>,
				<(0)>;
	};

	cpu_npll_4000: cpu_npll_4000 {
		compatible = "telechips,clk-pll";
		#clock-cells = <2>;
		clocks = <&osc24m 0 0>;
		clock-indices = <PLL_SP_DSU>,
				<PLL_SP_CA55_1>, <PLL_SP_CA55_0>,
				<PLL_MP_DSU>,
				<PLL_MP_CA76_3>, <PLL_MP_CA76_2>, <PLL_MP_CA76_1>, <PLL_MP_CA76_0>,
				<PLL_MP_CA55_3>, <PLL_MP_CA55_2>, <PLL_MP_CA55_1>, <PLL_MP_CA55_0>;
		clock-output-names =
				"pll_sp_dsu",
				"pll_sp_ca55_1", "pll_sp_ca55_0",
				"pll_mp_dsu",
				"pll_mp_ca76_3", "pll_mp_ca76_2", "pll_mp_ca76_1", "pll_mp_ca76_0",
				"pll_mp_ca55_3", "pll_mp_ca55_2", "pll_mp_ca55_1", "pll_mp_ca55_0";
		ccf-flags =
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>, /* PLL_SP_DSU */
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>, /* PLL_SP_CA55_1 */
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>, /* PLL_SP_CA55_0 */
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>, /* PLL_MP_DSU */
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>, /* PLL_MP_CA76_3 */
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>, /* PLL_MP_CA76_2 */
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>, /* PLL_MP_CA76_1 */
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>, /* PLL_MP_CA76_0 */
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>, /* PLL_MP_CA55_3 */
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>, /* PLL_MP_CA55_2 */
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>, /* PLL_MP_CA55_1 */
				<(CLK_IGNORE_UNUSED | CLK_IS_CRITICAL)>; /* PLL_MP_CA55_0 */

		tc-flags =
				<(0)>, /* PLL_SP_DSU */
				<(0)>, /* PLL_SP_CA55_1 */
				<(0)>, /* PLL_SP_CA55_0 */
				<(0)>, /* PLL_MP_DSU */
				<(0)>, /* PLL_MP_CA76_3 */
				<(0)>, /* PLL_MP_CA76_2 */
				<(0)>, /* PLL_MP_CA76_1 */
				<(0)>, /* PLL_MP_CA76_0 */
				<(0)>, /* PLL_MP_CA55_3 */
				<(0)>, /* PLL_MP_CA55_2 */
				<(0)>, /* PLL_MP_CA55_1 */
				<(0)>; /* PLL_MP_CA55_0 */
	};



	cpu_mp_ca55_0: cpu_mp_ca55_0 {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m        OSC_XIN       CPU_CLKCTRL_SEL_XIN>,
			<&cpu_npll_4000 PLL_MP_CA55_0 CPU_CLKCTRL_SEL_PLL>,
			<&cpu_npll_4000 PLL_MP_CA55_0 CPU_CLKCTRL_SEL_PLLDIV>;
		clock-indices = <FBUS_MP_CA55_0>;
		clock-output-names = "mp_ca55_0";
		ccf-flags = <(CLK_IS_CRITICAL)>;
		tc-flags =  <(0)>;
	};

	cpu_mp_ca55_1: cpu_mp_ca55_1 {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m        OSC_XIN       CPU_CLKCTRL_SEL_XIN>,
			<&cpu_npll_4000 PLL_MP_CA55_1 CPU_CLKCTRL_SEL_PLL>,
			<&cpu_npll_4000 PLL_MP_CA55_1 CPU_CLKCTRL_SEL_PLLDIV>;
		clock-indices = <FBUS_MP_CA55_1>;
		clock-output-names = "mp_ca55_1";
		ccf-flags = <(CLK_IS_CRITICAL)>;
		tc-flags =  <(0)>;
	};

	cpu_mp_ca55_2: cpu_mp_ca55_2 {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m        OSC_XIN       CPU_CLKCTRL_SEL_XIN>,
			<&cpu_npll_4000 PLL_MP_CA55_2 CPU_CLKCTRL_SEL_PLL>,
			<&cpu_npll_4000 PLL_MP_CA55_2 CPU_CLKCTRL_SEL_PLLDIV>;
		clock-indices = <FBUS_MP_CA55_2>;
		clock-output-names = "mp_ca55_2";
		ccf-flags = <(CLK_IS_CRITICAL)>;
		tc-flags =  <(0)>;
	};

	cpu_mp_ca55_3: cpu_mp_ca55_3 {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m        OSC_XIN       CPU_CLKCTRL_SEL_XIN>,
			<&cpu_npll_4000 PLL_MP_CA55_3 CPU_CLKCTRL_SEL_PLL>,
			<&cpu_npll_4000 PLL_MP_CA55_3 CPU_CLKCTRL_SEL_PLLDIV>;
		clock-indices = <FBUS_MP_CA55_3>;
		clock-output-names = "mp_ca55_3";
		ccf-flags = <(CLK_IS_CRITICAL)>;
		tc-flags =  <(0)>;
	};

	cpu_mp_ca76_0: cpu_mp_ca76_0 {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m        OSC_XIN       CPU_CLKCTRL_SEL_XIN>,
			<&cpu_npll_4000 PLL_MP_CA76_0 CPU_CLKCTRL_SEL_PLL>,
			<&cpu_npll_4000 PLL_MP_CA76_0 CPU_CLKCTRL_SEL_PLLDIV>;
		clock-indices = <FBUS_MP_CA76_0>;
		clock-output-names = "mp_ca76_0";
		ccf-flags = <(CLK_IS_CRITICAL)>;
		tc-flags =  <(0)>;

	};

	cpu_mp_ca76_1: cpu_mp_ca76_1 {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m        OSC_XIN       CPU_CLKCTRL_SEL_XIN>,
			<&cpu_npll_4000 PLL_MP_CA76_1 CPU_CLKCTRL_SEL_PLL>,
			<&cpu_npll_4000 PLL_MP_CA76_1 CPU_CLKCTRL_SEL_PLLDIV>;
		clock-indices = <FBUS_MP_CA76_1>;
		clock-output-names = "mp_ca76_1";
		ccf-flags = <(CLK_IS_CRITICAL)>;
		tc-flags =  <(0)>;
	};

	cpu_mp_ca76_2: cpu_mp_ca76_2 {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m        OSC_XIN       CPU_CLKCTRL_SEL_XIN>,
			<&cpu_npll_4000 PLL_MP_CA76_2 CPU_CLKCTRL_SEL_PLL>,
			<&cpu_npll_4000 PLL_MP_CA76_2 CPU_CLKCTRL_SEL_PLLDIV>;
		clock-indices = <FBUS_MP_CA76_2>;
		clock-output-names = "mp_ca76_2";
		ccf-flags = <(CLK_IS_CRITICAL)>;
		tc-flags =  <(0)>;
	};

	cpu_mp_ca76_3: cpu_mp_ca76_3 {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m        OSC_XIN       CPU_CLKCTRL_SEL_XIN>,
			<&cpu_npll_4000 PLL_MP_CA76_3 CPU_CLKCTRL_SEL_PLL>,
			<&cpu_npll_4000 PLL_MP_CA76_3 CPU_CLKCTRL_SEL_PLLDIV>;
		clock-indices = <FBUS_MP_CA76_3>;
		clock-output-names = "mp_ca76_3";
		ccf-flags = <(CLK_IS_CRITICAL)>;
		tc-flags =  <(0)>;
	};



	cpu_mp_dsu: cpu_mp_dsu {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m        OSC_XIN    CPU_CLKCTRL_SEL_XIN>,
			<&cpu_npll_4000 PLL_MP_DSU CPU_CLKCTRL_SEL_PLL>,
			<&cpu_npll_4000 PLL_MP_DSU CPU_CLKCTRL_SEL_PLLDIV>;
		clock-indices = <FBUS_MP_DSU>, <FBUS_MP_DSU_PCLK>;
		clock-output-names = "mp_dsu", "mp_dsu_pclk";
		ccf-flags =
			<(CLK_IS_CRITICAL)>,
			<(CLK_IS_CRITICAL)>;
		tc-flags =
			<(0)>,
			<(0)>;
	};

	cpu_sp_ca55_0: cpu_sp_ca55_0 {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m        OSC_XIN       CPU_CLKCTRL_SEL_XIN>,
			<&cpu_npll_4000 PLL_SP_CA55_0 CPU_CLKCTRL_SEL_PLL>,
			<&cpu_npll_4000 PLL_SP_CA55_0 CPU_CLKCTRL_SEL_PLLDIV>;
		clock-indices = <FBUS_SP_CA55_0>;
		clock-output-names = "sp_ca55_0";
		ccf-flags = <(CLK_IS_CRITICAL)>;
		tc-flags =  <(0)>;
	};

	cpu_sp_ca55_1: cpu_sp_ca55_1 {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m        OSC_XIN       CPU_CLKCTRL_SEL_XIN>,
			<&cpu_npll_4000 PLL_SP_CA55_1 CPU_CLKCTRL_SEL_PLL>,
			<&cpu_npll_4000 PLL_SP_CA55_1 CPU_CLKCTRL_SEL_PLLDIV>;
		clock-indices = <FBUS_SP_CA55_1>;
		clock-output-names = "sp_ca55_1";
		ccf-flags = <(CLK_IS_CRITICAL)>;
		tc-flags =  <(0)>;
	};

	cpu_sp_dsu: cpu_sp_dsu {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m        OSC_XIN    CPU_CLKCTRL_SEL_XIN>,
			<&cpu_npll_4000 PLL_SP_DSU CPU_CLKCTRL_SEL_PLL>,
			<&cpu_npll_4000 PLL_SP_DSU CPU_CLKCTRL_SEL_PLLDIV>;
		clock-indices = <FBUS_SP_DSU>, <FBUS_SP_DSU_PCLK>;
		clock-output-names = "sp_dsu", "sp_dsu_pclk";
		ccf-flags =
			<(CLK_IS_CRITICAL)>,
			<(CLK_IS_CRITICAL)>;
		tc-flags =
			<(0)>,
			<(0)>;
	};

	fbus_smu: fbus_smu {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&smu_npll_3200 PLL_0   SMU_CLKCTRL_SEL_PLL0>,
			<&smu_npll_3200 PLL_1   SMU_CLKCTRL_SEL_PLL1>,
			<&smu_dpll_3200 PLL_2   SMU_CLKCTRL_SEL_PLL2>,
			<&smu_dpll_3200 PLL_3   SMU_CLKCTRL_SEL_PLL3>,
			<&smu_dpll_3200 PLL_4   SMU_CLKCTRL_SEL_PLL4>,
			<&osc24m        OSC_XIN SMU_CLKCTRL_SEL_XIN>,
			<&osc24m        0       SMU_CLKCTRL_SEL_XIN>,
			<&smu_npll_3200 PLL_0   SMU_CLKCTRL_SEL_PLL0DIV>,
			<&smu_npll_3200 PLL_1   SMU_CLKCTRL_SEL_PLL1DIV>,
			<&smu_dpll_3200 PLL_2   SMU_CLKCTRL_SEL_PLL2DIV>,
			<&smu_dpll_3200 PLL_3   SMU_CLKCTRL_SEL_PLL3DIV>,
			<&smu_dpll_3200 PLL_4   SMU_CLKCTRL_SEL_PLL4DIV>,
			<&osc24m        OSC_XIN SMU_CLKCTRL_SEL_XIN>,
			<&osc24m        0       SMU_CLKCTRL_SEL_XIN>,
			<&osc24m        0       SMU_CLKCTRL_SEL_XIN>,
			<&osc24m        0       SMU_CLKCTRL_SEL_XIN>;
		clock-indices =
			<FBUS_CPU>, <FBUS_TAW>, <FBUS_HSIO>, <FBUS_SMU>,
			<FBUS_DDI>, <FBUS_IO>, <FBUS_HSM>, <FBUS_PCIe0>,
			<FBUS_PCIe1>;
		clock-output-names =
			"fbus_cbus", "fbus_taw", "fbus_hsio", "fbus_smu",
			"fbus_ddi", "fbus_io", "fbus_hsm", "fbus_pcie0",
			"fbus_pcie1";
		ccf-flags =
			<(CLK_IGNORE_UNUSED)>,	/* FBUS_CBUS */
			<(CLK_IS_CRITICAL)>,	/* FBUS_TAW */
			<(CLK_IGNORE_UNUSED)>,	/* FBUS_HSIO */
			<(CLK_IGNORE_UNUSED)>,	/* FBUS_SMU */
			<(CLK_IGNORE_UNUSED)>,	/* FBUS_DDI */
			<(CLK_IS_CRITICAL)>,	/* FBUS_IO */
			<(CLK_IGNORE_UNUSED)>,	/* FBUS_HSM */
			<(CLK_IGNORE_UNUSED)>,	/* FBUS_PCIe0 */
			<(CLK_IGNORE_UNUSED)>;	/* FBUS_PCIe1 */
		tc-flags =
			<(0)>,	/* FBUS_CBUS */
			<(0)>,	/* FBUS_TAW */
			<(0)>,	/* FBUS_HSIO */
			<(0)>,	/* FBUS_SMU */
			<(0)>,	/* FBUS_DDI */
			<(0)>,	/* FBUS_IO */
			<(0)>,	/* FBUS_HSM */
			<(0)>,	/* FBUS_PCIe0 */
			<(0)>;	/* FBUS_PCIe1 */
	};

	clk_peri: clk_peri {
		compatible = "telechips,clk-peri";
		#clock-cells = <1>;
		clocks =
			<&smu_npll_3200	PLL_0		SMU_PCLKCTRL_SEL_PLL0>,
			<&smu_npll_3200	PLL_1		SMU_PCLKCTRL_SEL_PLL1>,
			<&smu_dpll_3200	PLL_2		SMU_PCLKCTRL_SEL_PLL2>,
			<&smu_dpll_3200	PLL_3		SMU_PCLKCTRL_SEL_PLL3>,
			<&smu_dpll_3200	PLL_4		SMU_PCLKCTRL_SEL_PLL4>,
			<&osc24m	OSC_XIN		SMU_PCLKCTRL_SEL_XIN>,
			<&osc32k	OSC_XTIN	SMU_PCLKCTRL_SEL_XIN>, /* Invalid Clock source ID */
			<&osc24m	0		SMU_PCLKCTRL_SEL_XIN>,
			<&osc24m	0		SMU_PCLKCTRL_SEL_XIN>,
			<&osc24m	0		SMU_PCLKCTRL_SEL_XIN>,
			<&smu_npll_3200	PLL_0		SMU_PCLKCTRL_SEL_PLL0DIV>,
			<&smu_npll_3200	PLL_1		SMU_PCLKCTRL_SEL_PLL1DIV>,
			<&smu_dpll_3200	PLL_2		SMU_PCLKCTRL_SEL_PLL2DIV>,
			<&smu_dpll_3200	PLL_3		SMU_PCLKCTRL_SEL_PLL3DIV>,
			<&smu_dpll_3200	PLL_4		SMU_PCLKCTRL_SEL_PLL4DIV>,
			<&osc24m	0		SMU_PCLKCTRL_SEL_XIN>,
			<&osc24m	0		SMU_PCLKCTRL_SEL_XIN>,
			<&osc24m	0		SMU_PCLKCTRL_SEL_XIN>,
			<&osc24m	0		SMU_PCLKCTRL_SEL_XIN>, /* PCIe PHY is not support */
			<&osc24m	0		SMU_PCLKCTRL_SEL_XIN>,
			<&osc24m	0		SMU_PCLKCTRL_SEL_XIN>,
			<&osc24m	0		SMU_PCLKCTRL_SEL_XIN>,
			<&osc24m	0		SMU_PCLKCTRL_SEL_XIN>,
			<&osc24m	OSC_XIN		SMU_PCLKCTRL_SEL_XINDIV>,
			<&osc32k	OSC_XTIN	SMU_PCLKCTRL_SEL_XIN>,
			<&extclk0	0		SMU_PCLKCTRL_SEL_EXTCLK0>,
			<&extclk1	0		SMU_PCLKCTRL_SEL_EXTCLK1>;

		clock-indices =
			<PERI_TCT>, <PERI_TCZ>,
			<PERI_LCDTIMER>, <PERI_LCD0>, <PERI_LCD1>,
			<PERI_LCD2>, <PERI_LCD3>, <PERI_LCD4>,
			<PERI_GMAC>, <PERI_GMAC_PTP>, <PERI_PCIE0_PHY_CR_CLK>,
			<PERI_PCIE1_PHY_CR_CLK>, <PERI_RMT>, <PERI_SDMMC1>,
			<PERI_SDMMC2>, <PERI_CAN0>, <PERI_CAN1>,
			<PERI_CAN2>, <PERI_CAN3>, <PERI_CAN4>,
			<PERI_CAN5>, <PERI_CAN6>, <PERI_PDM>,
			<PERI_CAN7>, <PERI_CAN8>, <PERI_I2C0>,
			<PERI_I2C1>, <PERI_I2C2>, <PERI_I2C3>,
			<PERI_UART0>, <PERI_UART1>, <PERI_UART2>,
			<PERI_UART3>, <PERI_CAN9>, <PERI_CAN10>,
			<PERI_CAN11>, <PERI_TS_RX0>, <PERI_GPSB0>,
			<PERI_GPSB1>, <PERI_GPSB2>, <PERI_GPSB3>,
			<PERI_GPSB4>, <PERI_GPSB5>, <PERI_UART4>,
			<PERI_TS_RX1>, <PERI_ADC>, <PERI_IC_TC>,
			<PERI_UART5>, <PERI_UART6>, <PERI_UART7>,
			<PERI_UART8>, <PERI_CB_WDT>, <PERI_OUT0>,
			<PERI_OUT1>, <PERI_OUT2>, <PERI_OUT3>,
			<PERI_OUT4>, <PERI_OUT5>, <PERI_HSMB>;

		clock-output-names =
			"peri_tct", "peri_tcz",
			"peri_lcdtimer", "peri_lcd0", "peri_lcd1",
			"peri_lcd2", "peri_lcd3", "peri_lcd4",
			"peri_gmac", "peri_gmac_ptp", "peri_pcie0_phy_cr_clk",
			"peri_pcie1_phy_cr_clk", "peri_rmt", "peri_sdmmc1",
			"peri_sdmmc2", "peri_can0", "peri_can1",
			"peri_can2", "peri_can3", "peri_can4",
			"peri_can5", "peri_can6", "peri_pdm",
