	fbus_mem: fbus_mem {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m		OSC_XIN    MEM_CLKCTRL_SEL_XIN>,
			<&subsys_dpll_3200	PLL_MEM_0  MEM_CLKCTRL_SEL_PLL0>,
			<&subsys_dpll_3200	PLL_MEM_1  MEM_CLKCTRL_SEL_PLL1>,
			<&subsys_dpll_3200	PLL_MEM_0  MEM_CLKCTRL_SEL_PLL0_DIV0>,
			<&subsys_dpll_3200	PLL_MEM_0  MEM_CLKCTRL_SEL_PLL0_DIV1>,
			<&subsys_dpll_3200	PLL_MEM_1  MEM_CLKCTRL_SEL_PLL1_DIV0>,
			<&subsys_dpll_3200	PLL_MEM_1  MEM_CLKCTRL_SEL_PLL1_DIV1>,
			<&osc32k		OSC_XTIN   MEM_CLKCTRL_SEL_XTIN>;
		clock-indices =
			<FBUS_MEM>, <FBUS_MEM_SMMU>,
			<FBUS_MEM_LPDDR>;
		clock-output-names =
			"fbus_mem", "fbus_mem_smmu",
			"fbus_mem_lpddr";
		ccf-flags =
			<(CLK_IS_CRITICAL)>,
			<(CLK_IS_CRITICAL)>,
			<(CLK_IS_CRITICAL)>;
		tc-flags =	<(0)>,	/* FBUS_MEM */
				<(0)>,	/* FBUS_MEM_SMMU */
				<(0)>;	/* FBUS_MEM_LPDDR */
	};

	fbus_dp: fbus_dp {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m           OSC_XIN DP_CLKCTRL_SEL_XIN>,
			<&subsys_npll_3200 PLL_DP  DP_CLKCTRL_SEL_PLL>,
			<&subsys_npll_3200 PLL_DP  DP_CLKCTRL_SEL_PLLDIV>;
		clock-indices =
			<FBUS_DDI_AXI>, <FBUS_DDI_AUX>,
			<FBUS_DDI_APB>;
		clock-output-names =
			"fbus_ddi_axi", "fbus_ddi_aux",
			"fbus_ddi_apb";
		ccf-flags =
			<(CLK_IGNORE_UNUSED)>,
			<(CLK_IGNORE_UNUSED)>,
			<(CLK_IGNORE_UNUSED)>;
		tc-flags =
			<(0)>,
			<(0)>,
			<(0)>;
	};

	fbus_gpu: fbus_gpu {
		compatible = "telechips,clk-fbus";
		#clock-cells = <1>;
		clocks =
			<&osc24m           OSC_XIN GPU_CLKCTRL_SEL_XIN>,
			<&subsys_dpll_3200 PLL_GPU GPU_CLKCTRL_SEL_PLL>,
			<&subsys_dpll_3200 PLL_GPU GPU_CLKCTRL_SEL_PLLDIV>;
		clock-indices = <FBUS_GPU>;
		clock-output-names = "fbus_gpu";
		ccf-flags = <(CLK_IGNORE_UNUSED)>;
		tc-flags =  <(0)>;
	};

