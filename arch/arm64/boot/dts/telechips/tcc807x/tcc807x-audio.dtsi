#include <dt-bindings/interrupt-controller/arm-gic.h>   
#include <dt-bindings/clock/telechips,tcc807x-clks.h>   

/ {
	aliases: aliases {
		adma0  = &adma0;
		adma1  = &adma1;
		adma2  = &adma2;
		adma3  = &adma3;
		adma4  = &adma4;
		adma5  = &adma5;
		adma6  = &adma6;
		adma7  = &adma7;
		i2s0 = &i2s0;
		i2s1 = &i2s1;
		i2s2 = &i2s2;
		i2s3 = &i2s3;
		i2s4 = &i2s4;
		i2s5 = &i2s5;
		i2s6 = &i2s6;
		i2s7 = &i2s7;
		spdif0 = &spdif0;
		spdif1 = &spdif1;
		spdif2 = &spdif2;
		spdif3 = &spdif3;
		spdif4 = &spdif4;
		spdif5 = &spdif5;
		spdif6 = &spdif6;
		spdif7 = &spdif7;
		volume0 = &volume0;
		volume1 = &volume1;
		volume2 = &volume2;
		volume3 = &volume3;
		volume4 = &volume4;
		volume5 = &volume5;
		volume6 = &volume6;
		volume7 = &volume7;
		mixer0 = &mixer0;
		mixer1 = &mixer1;
		mixer2 = &mixer2;
		mixer3 = &mixer3;
		mixer4 = &mixer4;
		mixer5 = &mixer5;
		mars0 = &mars0;
		mars1 = &mars1;
		mars2 = &mars2;
		mars3 = &mars3;
		mars4 = &mars4;
		masrc0 = &masrc0;
		masrc1 = &masrc1;
		masrc2 = &masrc2;
		masrc3 = &masrc3;
		masrc4 = &masrc4;
		masrc5 = &masrc5;
		fifo_controller0 = &fifo_controller0;
		fifo_controller1 = &fifo_controller1;
		fifo_controller2 = &fifo_controller2;
		fifo_controller3 = &fifo_controller3;
	};


	audio_cfg: audio_cfg@19601000{
		compatible = "telechips,audio-cfg-807x";
		reg = <0x0 0x19601000 0x0 0xB0>;
		dai_chmux = <99 99 99 99 99 99 99>;
			// i2s0(GPIO C ) - 0: MI2S(01), 1: I2S(00)
			// i2s1(GPIO MB) - 0: MI2S(04)
			// i2s2(GPIO G ) - 0: MI2S(02)
			// i2s3(GPIO A ) - 0: MI2S(00)
			// i2s4(GPIO E ) - 0: MI2S(03)
			// i2s5(GPIO E ) - 0: SI2S(04)
			// i2s6(GPIO E ) - 0: SI2S(05)
			// i2s7(GPIO C ) - 0: MI2S(01), 1: I2S(00)
		spdif_chmux = <99 99 99 99 99 99 99>;
			//spdif0(x) spdif1(x) spdif2(x) spdif3(x) spdif4(x) spdif5(x) spdif6(x)
		dp_chmux = <99 99 99 99>;
			// dp0(x) dp1(x) dp2(x) dp3(xx)

		/*
			MAIC0 MAIC1 MAIC2 MAIC3 MAIC4 MAIC5 MAIC6 MAIC7
			MAVC0 MAVC1 MAVC2 MAVC3 MAVC4 MAVC5 MAVC6 MAVC7
			MARS0 MARS1 MARS2 MARS3 MARS4 MARS5
			MASM0 MASM1 MASM2 MASM3 MASM4
			MASRC0 MASRC1 MASRC2 MASRC3 MASRC4 MASRC5
			MACFG0 MACFG1 MACFG2 MACFG3
		*/
		ar_cache = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
			   0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
			   0x00 0x00 0x00 0x00 0x00 0x00
			   0x00 0x00 0x00 0x00 0x00
			   0x00 0x00 0x00 0x00 0x00 0x00
			   0x00 0x00 0x00 0x00 >;
		ar_prot = <0x22 0x22 0x22 0x22 0x22 0x22 0x22 0x22
			   0x22 0x22 0x22 0x22 0x22 0x22 0x22 0x22
			   0x22 0x22 0x22 0x22 0x22 0x22
			   0x22 0x22 0x22 0x22 0x22
			   0x22 0x22 0x22 0x22 0x22 0x22
			   0x22 0x22 0x22 0x22 >;
		aw_cache = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
			   0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00
			   0x00 0x00 0x00 0x00 0x00 0x00
			   0x00 0x00 0x00 0x00 0x00
			   0x00 0x00 0x00 0x00 0x00 0x00
			   0x00 0x00 0x00 0x00 >;
		aw_prot = <0x22 0x22 0x22 0x22 0x22 0x22 0x22 0x22
			   0x22 0x22 0x22 0x22 0x22 0x22 0x22 0x22
			   0x22 0x22 0x22 0x22 0x22 0x22
			   0x22 0x22 0x22 0x22 0x22
			   0x22 0x22 0x22 0x22 0x22 0x22
			   0x22 0x22 0x22 0x22 >;
		resets = <&pmu_rst SMUBUS_AUDIO>;
		status = "disabled";
	};

	adma0: adma@19000000 {
		compatible = "telechips,adma";
		reg = <0x0 0x19000000 0x0 0x200>;
		interrupts = <GIC_SPI 341 IRQ_TYPE_EDGE_RISING>;
		have-hopcnt-clear = <1>;
		adrcnt-mode = <1>;
		hrsten-reg-offset = <0xC>;
		hrsten-bit-offset = <24>;
		status = "disabled";
	};

	adma1: adma@19010000 {
		compatible = "telechips,adma";
		reg = <0x0 0x19010000 0x0 0x200>;
		interrupts = <GIC_SPI 342 IRQ_TYPE_EDGE_RISING>;
		have-hopcnt-clear = <1>;
		adrcnt-mode = <1>;
		hrsten-reg-offset = <0x88>;
		hrsten-bit-offset = <3>;
		status = "disabled";
	};

	adma2: adma@19020000 {
