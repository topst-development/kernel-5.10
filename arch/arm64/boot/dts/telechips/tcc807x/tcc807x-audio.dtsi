	i2s0: i2s@19001000 {
		compatible = "telechips,i2s";
		reg = <0x0 0x19001000 0x0 0x50>,
		      <0x0 0x19000080 0x0 0x8>;
		clocks = <&peri_audio PERI_AUDIO_MAIC0_DAIF &peri_audio PERI_AUDIO_MAIC0_FILTER>;
		clock-frequency = <48000>;	// Default LRCK
		have-fifo-clear = <1>;
		audio-filter = <0>;
		// 0: disable, 1: clock only, 2: data only, 3: data and clock
		block-type = <1>; // 0: SI2S 1: MI2S
		adma = <&adma0>;
		type = <0>; /* 0: adma, 1: fifo(MAFC) */
		status = "disabled";
	};

	i2s1: i2s@19011000 {
