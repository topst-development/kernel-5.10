	};

	masrc0: masrc@19400000 {
		compatible = "telechips,masrc";
		// reg = <0x0 0x19400000 0x0 0x1000>;

		/* MASRC0, MAFC1, CKC for IP-PV MS1 */
		reg = <0x0 0x19400000 0x0 0x1000>,
				<0x0 0x19501000 0x0 0x1000>,
				<0x0 0x19600000 0x0 0x10000>;
		interrupts = <GIC_SPI 368 IRQ_TYPE_EDGE_RISING>;
		type = <0>; // 0: 8 channels, 1: 2 channels
		status = "disabled";
	};

	masrc1: masrc@19401000 {
		compatible = "telechips,masrc";
		reg = <0x0 0x19401000 0x0 0x1000>;
		interrupts = <GIC_SPI 369 IRQ_TYPE_EDGE_RISING>;
