	volume0: volume@19100000 {
		compatible = "telechips,volume";
		reg = <0x0 0x19100000 0x0 0x1000>;
		interrupts = <GIC_SPI 349 IRQ_TYPE_EDGE_RISING>;
		type = <0>; // 0: bypass, 1: volume control, 2: mute
		status = "disabled";
	};

	volume1: volume@19101000 {
		compatible = "telechips,volume";
		reg = <0x0 0x19101000 0x0 0x1000>;
