	mars0: mars@19200000 {
		compatible = "telechips,mars";
		/* MARS0, MAFC1, CKC for IP-PV MS1 */
		reg = <0x0 0x19200000 0x0 0x1000>,
				<0x0 0x19502000 0x0 0x1000>,
				<0x0 0x19600000 0x0 0x10000>;
		interrupts = <GIC_SPI 357 IRQ_TYPE_EDGE_RISING>;
		type = <0>; // 0: reorder, 1: discard, 2: duplicate, 3:discard
		status = "disabled";
	};

	mars1: mars@19201000 {
		compatible = "telechips,mars";
		reg = <0x0 0x19201000 0x0 0x1000>;
