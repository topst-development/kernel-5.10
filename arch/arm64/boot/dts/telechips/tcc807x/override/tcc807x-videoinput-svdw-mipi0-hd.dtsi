&tcc_svdw {
	status		= "okay";
	memory-region	= <&pmap_svdw
			   &pmap_svdw_overlay>;

	ports {
		port@0 {
			svdw_in0: endpoint {
				remote-endpoint = <&videoinput0_out>;
				io-direction = "input";
			};
		};
		port@1 {
			svdw_in1: endpoint {
				remote-endpoint = <&videoinput1_out>;
				io-direction = "input";
			};
		};
		port@2 {
			svdw_in2: endpoint {
				remote-endpoint = <&videoinput2_out>;
				io-direction = "input";
			};
		};
		port@3 {
			svdw_in3: endpoint {
				remote-endpoint = <&videoinput3_out>;
				io-direction = "input";
			};
		};
	};
};
