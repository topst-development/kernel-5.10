				remote-endpoint = <&mipi_csi2_0_out1>;
				io-direction	= "input";
			};
		};
		port@1 {
			videoinput1_out: endpoint {
				remote-endpoint = <&svdw_in1>;
				io-direction	= "output";
			};
		};
	};
};

&videoinput2 {
	status		= "okay";
	cam-ch		= <2>;
	/* memory-region
	 *  - [0]: parking guideline
	 *  - [1]: preview
	 */
	memory-region	= <0
			   &pmap_rearcamera2>;
	ports {
		port@0 {
			videoinput2_in: endpoint {
				remote-endpoint	= <&mipi_csi2_0_out2>;
				io-direction	= "input";
			};
		};
		port@1 {
			videoinput2_out: endpoint {
				remote-endpoint = <&svdw_in2>;
				io-direction	= "output";
			};
		};
	};
};

&videoinput3 {
	status		= "okay";
	cam-ch		= <3>;
	/* memory-region
	 *  - [0]: parking guideline
	 *  - [1]: preview
	 */
	memory-region	= <0
			   &pmap_rearcamera3>;
	ports {
		port@0 {
			videoinput3_in: endpoint {
				remote-endpoint = <&mipi_csi2_0_out3>;
				io-direction	= "input";
			};
		};
		port@1 {
			videoinput3_out: endpoint {
				remote-endpoint = <&svdw_in3>;
