menu "LCD panels for TELECHISP SIMPLE FB"
	depends on TELECHIPS_SIMPLE_FB

config TELECHIPS_FB_LVDS_PANEL
	bool "LVDS panel drivers"
	depends on OF && TELECHIPS_SIMPLE_FB && ARCH_TCC805X
	default y if ARCH_TCC805X
	select VIDEOMODE_HELPERS
	help
	  This driver supports LVDS panels that don't require device-specific
	  handling of power supplies or control signals.

config TELECHIPS_FB_DSI_PANEL
	bool "DSI panel drivers"
	depends on OF && TELECHIPS_SIMPLE_FB && ARCH_TCC807X
	default y if ARCH_TCC807X
	select VIDEOMODE_HELPERS
	help
	  This driver supports DSI panels that don't require device-specific
	  handling of power supplies or control signals.

config TELECHIPS_FB_CTRL_BACKLIGHT
	tristate "binding TCC LVDS & DP backlight driver(gpio, pwm ...)"
	depends on OF && FB_NEW && (ARCH_TCC805X || ARCH_TCC807X)
	help
	  This driver supports to bind FB_PANEL_XXX_TCC and backlight driver.

endmenu
