# config V4L2_TCCVENC
# 	tristate "Telechips Video Encoder Driver"
# 	default m
# 	help
# 	Support v4l2 encoder interface

# 	Note that the driver is supported on the following chipsets.
# 	- tcc807x

config VIDEO_TELECHIPS_VPU_ENCODER
	tristate "Telechips Video Encoder Driver"
	depends on VIDEO_DEV && VIDEO_V4L2
	select VIDEOBUF2_DMA_CONTIG
	select V4L2_MEM2MEM_DEV
	help