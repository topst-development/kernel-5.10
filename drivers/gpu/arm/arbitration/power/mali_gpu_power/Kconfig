config MALI_GPU_POWER_MODULES
	tristate "Enable gpu power modules"
	depends on MALI_ARBITRATION
	default y
	help
	  Enables the build of the gpu power modules used in the reference
	  virtualization setup for Mali
	  If unsure, say N

